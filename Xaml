<Window
    x:Class="Multi_Revit_Version_Window.Array_Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Multi_Revit_Version_Window"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="600"
    Height="500"
    BorderBrush="Black"
    FontFamily="Arial"
    Foreground="Black"
    KeyDown="Window_KeyDown"
    MouseDown="Window_MouseDown"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="50" />
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Height="20"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Name="Minimize_Button"
                Width="20"
                Height="20"
                Margin="0,0,5,0"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="Minimize_Button_Click"
                Content="_"
                FontSize="14" />
            <Button
                x:Name="Maximize_Button"
                Width="20"
                Height="20"
                Margin="0,0,5,0"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="Maximize_Button_Click"
                Content="🗖" />
            <Button
                x:Name="Close_Button"
                Width="20"
                Height="20"
                Margin="0,0,5,0"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="Close_Button_Click"
                Content="X" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ComboBox
                x:Name="MEPType_Combobox"
                Width="100"
                Margin="0,0,0,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                SelectionChanged="MEPType_Combobox_SelectionChanged" />
            <TextBlock
                Margin="0,2,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="MEP Type"
                TextWrapping="Wrap" />


            <TextBlock
                Grid.Column="2"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="Level and Offset"
                TextWrapping="Wrap" />

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="SettingOut_Combobox"
                    Grid.Column="0"
                    Width="150"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" />
                <RadioButton
                    x:Name="Right_RadioButton"
                    Grid.Column="1"
                    Margin="10,0,0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Content="Right"
                    GroupName="SettingOutGroup"
                    IsChecked="True" />

                <RadioButton
                    x:Name="Left_RadioButton"
                    Grid.Column="1"
                    Margin="10,0,0,20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Content="Left"
                    GroupName="SettingOutGroup" />


            </Grid>

            <TextBlock
                Grid.Column="1"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="Setting Out"
                TextWrapping="Wrap" />

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="Level_Combobox"
                    Grid.Column="0"
                    Width="150"
                    Margin="0,0,0,5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" />
                <TextBox
                    x:Name="LevelOffset_TextBox"
                    Grid.Column="1"
                    Width="50"
                    Height="25"
                    Margin="0,0,0,2.5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    Text="0"
                    TextAlignment="Center" />

            </Grid>

        </Grid>

        <DataGrid
            x:Name="MepDataGrid"
            Grid.Row="2"
            Margin="0,0,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            GridLinesVisibility="All"
            HeadersVisibility="Column"
            IsReadOnly="False"
            ItemsSource="{Binding GridItems}">

            <DataGrid.Resources>
                <Style x:Key="CenterTextStyle" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="TextBlock.TextAlignment" Value="Center" />
                    <Setter Property="Height" Value="40" />
                </Style>
            </DataGrid.Resources>



            <DataGrid.Columns>
                <!--  1. No. 欄位  -->
                <DataGridTextColumn
                    Width="0.3*"
                    Binding="{Binding No, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ElementStyle="{StaticResource CenterTextStyle}"
                    Header="No."
                    HeaderStyle="{StaticResource CenterHeaderStyle}"
                    IsReadOnly="True" />

                <!--  Type 下拉選單  -->
                <DataGridTemplateColumn
                    Width="1*"
                    Header="Type"
                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding DataContext.Typelist, RelativeSource={RelativeSource AncestorType=Window}}"
                                SelectedValue="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectionChanged="GridType_SelectionChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  System Type 下拉選單  -->
                <DataGridTemplateColumn
                    Width="1.2*"
                    Header="System Type"
                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding DataContext.SystemTypeList, RelativeSource={RelativeSource AncestorType=Window}}"
                                SelectedValue="{Binding SystemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="1.1*" HeaderStyle="{StaticResource CenterHeaderStyle}">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding Size}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Grid>
                                <ComboBox
                                    x:Name="PipeSizeCombo"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    ItemsSource="{Binding LocalPipeSizeList}"
                                    SelectedValue="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="Collapsed" />

                                <!--  當大類別是 Duct / Cable Tray 時顯示的 TextBox  -->
                                <!--  💡 核心優化：加上 Focusable=True 與明確的背景，確保能吸收到滑鼠焦點  -->
                                <TextBox
                                    x:Name="MepSizeText"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="True"
                                    Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="Visible" />
                            </Grid>

                            <!--  根據最上方大選單切換誰要出現  -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MEPType_Combobox}" Value="0">
                                    <Setter TargetName="PipeSizeCombo" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="MepSizeText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>

                    <!--  標題自動切換邏輯 (維持不變)  -->
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Size&#x0a;(Dia)" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MEPType_Combobox}" Value="1">
                                                <Setter Property="Text" Value="Size&#x0a;(WxH)" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MEPType_Combobox}" Value="2">
                                                <Setter Property="Text" Value="Size&#x0a;(WxH)" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                </DataGridTemplateColumn>


                <!--  5. Interval 欄位  -->
                <DataGridTextColumn
                    Width="0.9*"
                    Binding="{Binding Interval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ElementStyle="{StaticResource CenterTextStyle}"
                    Header="Interval"
                    HeaderStyle="{StaticResource CenterHeaderStyle}" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="Total Rows : " />
                <TextBox
                    x:Name="TxtRowCount"
                    Width="40"
                    Margin="0,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="12"
                    KeyDown="TxtRowCount_KeyDown"
                    Text="3" />
                <!--  ⚡ 關鍵修改：改成 KeyDown 事件  -->
            </StackPanel>
            <Button
                x:Name="Done_Button"
                Grid.Column="1"
                Width="65"
                Height="25"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="Done_Button_Click"
                Content="Done" />
        </Grid>

    </Grid>
</Window>
